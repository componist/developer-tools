{
    "name": "componist/developer-tools",
    "description": "Local Laravel developer tools UI: schema browser, Artisan helpers, logs, env viewer, and database truncate utilities",
    "keywords": [
        "laravel",
        "developer-tools",
        "debug",
        "livewire",
        "schema",
        "artisan",
        "local",
        "componist"
    ],
    "homepage": "https://componist.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Componist Developer",
            "email": "info@componist.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "componist/core": "^1.0.0",
        "guzzlehttp/guzzle": "^7.0",
        "livewire/livewire": "^4.0",
        "symfony/dom-crawler": "^7.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.9"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c phpstan.neon.dist"
    },
    "autoload": {
        "psr-4": {
            "Componist\\DeveloperTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componist\\DeveloperTools\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Componist\\DeveloperTools\\DeveloperToolsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
